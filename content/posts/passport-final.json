  "bodyHtml": "<style>\n.pz-wrap{max-width:780px;margin:0 auto;font-family:'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1a1830}\n.pz-eyebrow{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#6b46fa;margin-bottom:10px}\n.pz-title{font-size:28px;font-weight:800;color:#1a1830;line-height:1.2;margin:0 0 12px}\n.pz-title span{background:linear-gradient(90deg,#6b46fa,#9b72ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}\n.pz-desc{color:#7b78a0;font-size:14px;max-width:560px;margin:0 0 32px}\n.pz-tabs input[type=radio]{display:none}\n.pz-tab-labels{display:flex;gap:6px;margin-bottom:20px;flex-wrap:wrap}\n.pz-tab-label{padding:7px 16px;border-radius:20px;font-size:13px;font-weight:600;cursor:pointer;border:1px solid #e0e0ec;background:#f7f7fb;color:#7b78a0;transition:all .15s;user-select:none}\n.pz-tab-content{display:none}\n#tab-rf:checked ~ .pz-tab-labels label[for=\"tab-rf\"],\n#tab-zg:checked ~ .pz-tab-labels label[for=\"tab-zg\"]{background:#6b46fa;color:#fff;border-color:#6b46fa}\n#tab-rf:checked ~ .pz-panels #panel-rf{display:block}\n#tab-zg:checked ~ .pz-panels #panel-zg{display:block}\n.pz-section{margin-bottom:32px}\n.pz-section-label{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#7b78a0;margin:0 0 16px;display:flex;align-items:center;gap:8px}\n.pz-section-label::after{content:'';flex:1;height:1px;background:#e0e0ec}\n.pz-card{background:#f7f7fb;border:1px solid #e0e0ec;border-radius:12px;overflow:hidden;margin-bottom:20px}\n.pz-card-head{display:flex;align-items:center;gap:10px;padding:11px 16px;background:#eeeef6;border-bottom:1px solid #e0e0ec;flex-wrap:wrap}\n.pz-card-meta{font-size:12px;color:#7b78a0;margin-left:auto}\n.pz-card-body{padding:15px 16px;font-family:'Courier New',monospace;font-size:13px;line-height:1.7;color:#2d2a4a;white-space:pre-wrap;word-break:break-word;background:#fafafa;margin:0}\n.pz-ru{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;background:rgba(217,48,37,.08);color:#d93025;border:1px solid rgba(217,48,37,.2)}\n.pz-en{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;background:rgba(26,115,232,.08);color:#1a73e8;border:1px solid rgba(26,115,232,.2)}\n.pz-copy{background:#f0edff;border:1px solid #cfc4ff;color:#6b46fa;font-size:12px;font-weight:600;padding:5px 12px;border-radius:6px;cursor:pointer;font-family:inherit;margin-left:auto;transition:all .15s}\n.pz-copy:hover{background:#6b46fa;color:#fff;border-color:#6b46fa}\n.pz-copy.ok{background:#e8f5e9;color:#2e7d32;border-color:#a5d6a7}\n.pz-ba{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 16px 16px}\n.pz-ba-item{background:#fff;border:1px solid #e0e0ec;border-radius:10px;overflow:hidden}\n.pz-ba-img{width:100%;aspect-ratio:3/4;background:#f0f0f0;overflow:hidden}\n.pz-ba-img img{width:100%;height:100%;object-fit:cover;display:block}\n.pz-ba-cap{padding:8px 12px;border-top:1px solid #e0e0ec;display:flex;align-items:center;gap:6px}\n.pz-badge-before{font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px;background:#fff3e0;color:#e65100;border:1px solid #ffcc80}\n.pz-badge-after{font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px;background:#e8f5e9;color:#2e7d32;border:1px solid #a5d6a7}\n.pz-ba-cap-text{font-size:12px;color:#7b78a0}\n.pz-tool{background:#f7f7fb;border:1px solid #e0e0ec;border-radius:12px;overflow:hidden;margin-bottom:20px}\n.pz-tool-head{display:flex;align-items:center;gap:10px;padding:13px 18px;background:#eeeef6;border-bottom:1px solid #e0e0ec}\n.pz-tool-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}\n.pz-tool-icon-gpt{background:linear-gradient(135deg,#10a37f,#1a7a5e)}\n.pz-tool-icon-nano{background:linear-gradient(135deg,#7c5cfc,#4e35b0)}\n.pz-tool-name{font-weight:700;font-size:15px;color:#1a1830}\n.pz-tool-tag{font-size:11px;color:#7b78a0;background:#fff;border:1px solid #e0e0ec;padding:2px 8px;border-radius:4px;margin-left:auto}\n.pz-tool-body{padding:14px;display:flex;flex-direction:column;gap:12px}\n.pz-mini{background:#fff;border:1px solid #e0e0ec;border-radius:8px;overflow:hidden;margin-bottom:0}\n.pz-mini-head{display:flex;align-items:center;gap:8px;padding:8px 14px;background:#eeeef6;border-bottom:1px solid #e0e0ec}\n.pz-mini-body{padding:12px 14px;font-family:'Courier New',monospace;font-size:12.5px;line-height:1.65;color:#2d2a4a;white-space:pre-wrap;word-break:break-word;margin:0}\n.pz-mini-ba{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 14px 14px}\n.pz-howto{background:linear-gradient(135deg,rgba(107,70,250,.05),rgba(155,114,255,.03));border:1px solid rgba(107,70,250,.18);border-radius:12px;padding:22px;margin-bottom:12px}\n.pz-howto-title{font-size:14px;font-weight:700;color:#6b46fa;margin:0 0 16px}\n.pz-steps{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px}\n.pz-step{display:flex;gap:12px;align-items:flex-start}\n.pz-step-num{width:24px;height:24px;background:#6b46fa;color:#fff;font-size:11px;font-weight:800;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}\n.pz-step-text{font-size:14px;color:#1a1830;line-height:1.5}\n.pz-wrap strong{color:inherit}\n.pz-wrap a{color:inherit;text-decoration:none}\n.pz-wrap a:hover{text-decoration:underline}\n.pz-divider{height:1px;background:#e0e0ec;margin:28px 0}\n.pz-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}\n.pz-tag{background:#f0edff;border:1px solid #cfc4ff;color:#6b46fa;font-size:12px;font-weight:600;padding:5px 13px;border-radius:20px}\n</style>\n\n<div class=\"pz-wrap\">\n\n  <div class=\"pz-eyebrow\">Промтзилла</div>\n  <h2 class=\"pz-title\">Как сделать фотографию на паспорт через ИИ</h2>\n  <p class=\"pz-desc\">Готовые промты для создания документальных фото по вашей фотографии. Внутренний паспорт РФ и загранпаспорт (ИКАО).</p>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Как использовать на <a href=\"https://eduforms.ru/?rid=adeaad5a9be53cc5&erid=2SDnjcsXiW6&ulp=https%3A%2F%2Fstudy24.ai%2F&subid=promtzilla&subid2=kak_sdelat_foto_na_pasport_s_pomoschyu_ii\" rel=\"sponsored noopener\" target=\"_blank\">Study AI</a></div>\n    <div class=\"pz-howto\">\n      <div class=\"pz-howto-title\">📋 Пошаговая инструкция</div>\n      <ul class=\"pz-steps\">\n        <li class=\"pz-step\"><div class=\"pz-step-num\">1</div><div class=\"pz-step-text\">Перейди на <strong>study24.ai</strong> и открой инструмент <strong><a href=\"https://eduforms.ru/?rid=adeaad5a9be53cc5&erid=2SDnjcsXiW6&ulp=https%3A%2F%2Fstudy24.ai%2Fchat%2Fnano_banana_pro&subid=promtzilla&subid2=kak_sdelat_foto_na_pasport_s_pomoschyu_ii\" rel=\"sponsored noopener\" target=\"_blank\">Nano Banana PRO</a></strong></div></li>\n        <li class=\"pz-step\"><div class=\"pz-step-num\">2</div><div class=\"pz-step-text\">Нажми на иконку скрепки и <strong>загрузи своё фото</strong> — подойдёт любое чёткое фото анфас</div></li>\n        <li class=\"pz-step\"><div class=\"pz-step-num\">3</div><div class=\"pz-step-text\">Скопируй промт ниже и <strong>вставь в поле ввода</strong></div></li>\n        <li class=\"pz-step\"><div class=\"pz-step-num\">4</div><div class=\"pz-step-text\">Нажми отправить и подожди 10–20 секунд — нейросеть <strong>обработает фото</strong></div></li>\n        <li class=\"pz-step\"><div class=\"pz-step-num\">5</div><div class=\"pz-step-text\">Если фон не белый — добавь к промту: <strong>«фон строго белый #FFFFFF»</strong></div></li>\n        <li class=\"pz-step\"><div class=\"pz-step-num\">6</div><div class=\"pz-step-text\">Скачай результат и <strong>распечатай в формате 35×45 мм</strong></div></li>\n      </ul>\n    </div>\n  </div>\n\n  <div class=\"pz-tabs\">\n    <input type=\"radio\" name=\"pztab\" id=\"tab-rf\" checked>\n    <input type=\"radio\" name=\"pztab\" id=\"tab-zg\">\n    <div class=\"pz-tab-labels\">\n      <label class=\"pz-tab-label\" for=\"tab-rf\">🇷🇺 Внутренний паспорт РФ</label>\n      <label class=\"pz-tab-label\" for=\"tab-zg\">🌍 Загранпаспорт (ИКАО)</label>\n    </div>\n    <div class=\"pz-panels\">\n\n      <!-- ===== ВНУТРЕННИЙ ===== -->\n      <div class=\"pz-tab-content\" id=\"panel-rf\">\n\n        <div class=\"pz-section\">\n          <div class=\"pz-section-label\">Универсальные промты</div>\n\n          <!-- RU универсальный — с фото -->\n          <div class=\"pz-card\">\n            <div class=\"pz-card-head\">\n              <span class=\"pz-ru\">RU</span>\n              <span class=\"pz-card-meta\">Работает в любом редакторе с загрузкой фото</span>\n              <button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button>\n            </div>\n            <pre class=\"pz-card-body\">На входе — фотография человека. Преврати её в фото на внутренний паспорт РФ (формат 35×45 мм).\n\nТребования:\n— Фон заменить на чисто белый (#FFFFFF), без теней и градиентов\n— Лицо, кожу, волосы и внешность человека не изменять вообще\n— Лицо по центру кадра, занимает 70–80% высоты\n— Плечи видны\n— Равномерное мягкое студийное освещение, тени на лице и фоне убрать\n— Без очков, без головного убора\n— Выражение лица, возраст и внешность — только как в оригинале</pre>\n            <div class=\"pz-ba\">\n              <div class=\"pz-ba-item\">\n                <div class=\"pz-ba-img\"><img src=\"/wp-content/uploads/2026/06/Как-сделать-фото-на-паспорт-с-помощью-нейросети.jpg\" alt=\"До\"></div>\n                <div class=\"pz-ba-cap\"><span class=\"pz-badge-before\">До</span><span class=\"pz-ba-cap-text\">Исходное фото</span></div>\n              </div>\n              <div class=\"pz-ba-item\">\n                <div class=\"pz-ba-img\"><img src=\"/wp-content/uploads/2026/06/Как-сделать-фото-на-паспорт-с-помощью-нейросети-2.jpg\" alt=\"После\"></div>\n                <div class=\"pz-ba-cap\"><span class=\"pz-badge-after\">После</span><span class=\"pz-ba-cap-text\">Паспортное фото</span></div>\n              </div>\n            </div>\n          </div>\n\n          <!-- EN универсальный — без фото -->\n          <div class=\"pz-card\">\n            <div class=\"pz-card-head\">\n              <span class=\"pz-en\">EN</span>\n              <span class=\"pz-card-meta\">Universal, works in any image editor</span>\n              <button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button>\n            </div>\n            <pre class=\"pz-card-body\">Input is a real photo of a person.\nConvert it to a Russian internal passport photo, 35x45mm format.\n\nRules:\n— Replace the background with pure white (#FFFFFF), no shadows, no gradients\n— Keep the person's face 100% unchanged: skin tone, hair, features, expression\n— Crop so the face is centered and occupies 70–80% of the frame\n— Shoulders must be visible\n— Apply soft, even frontal studio lighting, eliminate all shadows\n— No glasses, no headwear\n— Do not alter age or appearance in any way</pre>\n          </div>\n        </div>\n\n        <div class=\"pz-section\">\n          <div class=\"pz-section-label\">Под конкретные инструменты</div>\n\n          <!-- GPT Image 2 — без фото -->\n          <div class=\"pz-tool\">\n            <div class=\"pz-tool-head\">\n              <div class=\"pz-tool-icon pz-tool-icon-gpt\">✦</div>\n              <div class=\"pz-tool-name\"><a href=\"https://eduforms.ru/?rid=adeaad5a9be53cc5&erid=2SDnjcsXiW6&ulp=https%3A%2F%2Fstudy24.ai%2Fchat%2Fgpt_image&subid=promtzilla&subid2=kak_sdelat_foto_na_pasport_s_pomoschyu_ii\" rel=\"sponsored noopener\" target=\"_blank\">GPT Image 2</a></div>\n              <div class=\"pz-tool-tag\">Edit mode · загрузи фото</div>\n            </div>\n            <div class=\"pz-tool-body\">\n              <div class=\"pz-mini\">\n                <div class=\"pz-mini-head\">\n                  <span class=\"pz-ru\">RU</span>\n                  <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n                </div>\n                <pre class=\"pz-mini-body\">Отредактируй загруженное фото: замени фон на чисто белый, убери все тени с фона и лица. Лицо, волосы, кожу и внешность человека не изменяй — оставь в точности как в оригинале. Обрежь до формата фото на документ: лицо по центру, занимает 70–80% кадра, видны плечи. Мягкое равномерное освещение. Формат 35×45 мм, внутренний паспорт РФ.</pre>\n              </div>\n              <div class=\"pz-mini\">\n                <div class=\"pz-mini-head\">\n                  <span class=\"pz-en\">EN</span>\n                  <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n                </div>\n                <pre class=\"pz-mini-body\">Edit the uploaded photo: replace background with pure white, remove all shadows. Keep the person's face, hair, and skin exactly as in the original — do not change appearance. Crop to passport format: face centered, occupying 70–80% of frame, shoulders visible. Soft even studio lighting. 35x45mm, Russian internal passport standard.</pre>\n              </div>\n            </div>\n          </div>\n\n          <!-- Nano Banana PRO — без фото -->\n          <div class=\"pz-tool\">\n            <div class=\"pz-tool-head\">\n              <div class=\"pz-tool-icon pz-tool-icon-nano\">🍌</div>\n              <div class=\"pz-tool-name\">Nano Banana PRO</div>\n              <div class=\"pz-tool-tag\">Study AI · загрузи фото</div>\n            </div>\n            <div class=\"pz-tool-body\">\n              <div class=\"pz-mini\">\n                <div class=\"pz-mini-head\">\n                  <span class=\"pz-ru\">RU</span>\n                  <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n                </div>\n                <pre class=\"pz-mini-body\">Загружаю своё фото. Сделай из него фото на внутренний паспорт РФ 35×45 мм. Белый фон без теней. Внешность не менять. Лицо по центру, плечи видны. Равномерный свет. Без очков и головного убора.</pre>\n              </div>\n              <div class=\"pz-mini\">\n                <div class=\"pz-mini-head\">\n                  <span class=\"pz-en\">EN</span>\n                  <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n                </div>\n                <pre class=\"pz-mini-body\">I'm uploading my photo. Convert it to a Russian internal passport photo, 35x45mm. White background, no shadows. Do not change my appearance. Face centered, shoulders visible. Even lighting. No glasses or headwear.</pre>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div><!-- /panel-rf -->\n\n      <!-- ===== ЗАГРАНПАСПОРТ ===== -->\n      <div class=\"pz-tab-content\" id=\"panel-zg\">\n\n        <div class=\"pz-section\">\n          <div class=\"pz-section-label\">Универсальные промты</div>\n\n          <!-- RU универсальный — с фото -->\n          <div class=\"pz-card\">\n            <div class=\"pz-card-head\">\n              <span class=\"pz-ru\">RU</span>\n              <span class=\"pz-card-meta\">Работает в любом редакторе с загрузкой фото</span>\n              <button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button>\n            </div>\n            <pre class=\"pz-card-body\">На входе — фотография человека. Преврати её в биометрическое фото на загранпаспорт РФ по стандарту ИКАО (35×45 мм).\n\nТребования:\n— Фон — чисто белый, без теней, бликов и переходов\n— Внешность человека не менять: лицо, кожа, волосы — строго как в оригинале\n— Высота лица от подбородка до макушки — 32–36 мм в кадре\n— Голова прямо, взгляд в объектив, глаза открыты\n— Нейтральное выражение, рот закрыт, без улыбки\n— Очки убрать, если есть\n— Диффузное равномерное освещение по всему лицу, никаких теней</pre>\n            <div class=\"pz-ba\">\n              <div class=\"pz-ba-item\">\n                <div class=\"pz-ba-img\"><img src=\"/wp-content/uploads/2026/06/Как-сделать-фото-на-паспорт-с-помощью-нейросети.jpg\" alt=\"До\"></div>\n                <div class=\"pz-ba-cap\"><span class=\"pz-badge-before\">До</span><span class=\"pz-ba-cap-text\">Исходное фото</span></div>\n              </div>\n              <div class=\"pz-ba-item\">\n                <div class=\"pz-ba-img\"><img src=\"/wp-content/uploads/2026/06/Как-сделать-фото-на-загранпаспорт-с-помощью-нейросети-2.jpg\" alt=\"После\"></div>\n                <div class=\"pz-ba-cap\"><span class=\"pz-badge-after\">После</span><span class=\"pz-ba-cap-text\">Паспортное фото</span></div>\n              </div>\n            </div>\n          </div>\n\n          <!-- EN универсальный — без фото -->\n          <div class=\"pz-card\">\n            <div class=\"pz-card-head\">\n              <span class=\"pz-en\">EN</span>\n              <span class=\"pz-card-meta\">Universal, works in any image editor</span>\n              <button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button>\n            </div>\n            <pre class=\"pz-card-body\">Input is a real photo of a person.\nConvert to Russian biometric international passport photo, ICAO standard, 35x45mm.\n\nRules:\n— Pure white background, no shadows or gradients\n— Face completely unchanged — same person, same features, same skin\n— Face height from chin to crown: 32–36mm within the 45mm frame\n— Head strictly straight, eyes open, looking at camera\n— Neutral expression only, mouth closed, no smile\n— Remove glasses if present\n— Uniform diffused lighting across the entire face, no shadows or highlights</pre>\n          </div>\n        </div>\n\n        <div class=\"pz-section\">\n          <div class=\"pz-section-label\">Под конкретные инструменты</div>\n\n          <!-- GPT Image 2 — без фото -->\n          <div class=\"pz-tool\">\n            <div class=\"pz-tool-head\">\n              <div class=\"pz-tool-icon pz-tool-icon-gpt\">✦</div>\n              <div class=\"pz-tool-name\">GPT Image 2</div>\n              <div class=\"pz-tool-tag\">Edit mode · загрузи фото</div>\n            </div>\n            <div class=\"pz-tool-body\">\n              <div class=\"pz-mini\">\n                <div class=\"pz-mini-head\">\n                  <span class=\"pz-ru\">RU</span>\n                  <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n                </div>\n                <pre class=\"pz-mini-body\">Отредактируй фото под биометрический загранпаспорт РФ, стандарт ИКАО, 35×45 мм. Замени фон на чисто белый без теней. Лицо и внешность не изменяй. Высота лица в кадре 32–36 мм. Голова прямо, взгляд в камеру, рот закрыт, без улыбки. Убери очки если есть. Равномерное диффузное освещение без теней на лице.</pre>\n              </div>\n              <div class=\"pz-mini\">\n                <div class=\"pz-mini-head\">\n                  <span class=\"pz-en\">EN</span>\n                  <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n                </div>\n                <pre class=\"pz-mini-body\">Edit this photo for a Russian biometric international passport, ICAO standard, 35x45mm. Replace background with pure white, no shadows. Do not change face or appearance. Face height 32–36mm in frame. Head straight, eyes open, mouth closed, no smile. Remove glasses if present. Uniform diffused lighting, no shadows on face.</pre>\n              </div>\n            </div>\n          </div>\n\n          <!-- Nano Banana PRO — без фото -->\n          <div class=\"pz-tool\">\n            <div class=\"pz-tool-head\">\n              <div class=\"pz-tool-icon pz-tool-icon-nano\">🍌</div>\n              <div class=\"pz-tool-name\">Nano Banana PRO</div>\n              <div class=\"pz-tool-tag\">Study AI · загрузи фото</div>\n            </div>\n            <div class=\"pz-tool-body\">\n              <div class=\"pz-mini\">\n                <div class=\"pz-mini-head\">\n                  <span class=\"pz-ru\">RU</span>\n                  <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n                </div>\n                <pre class=\"pz-mini-body\">Загружаю своё фото. Сделай биометрическое фото на загранпаспорт РФ, стандарт ИКАО, 35×45 мм. Белый фон без теней. Внешность не менять. Лицо 32–36 мм высотой, голова прямо, взгляд в камеру, рот закрыт. Очки убрать. Равномерный свет без теней.</pre>\n              </div>\n              <div class=\"pz-mini\">\n                <div class=\"pz-mini-head\">\n                  <span class=\"pz-en\">EN</span>\n                  <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n                </div>\n                <pre class=\"pz-mini-body\">I'm uploading my photo. Make a biometric international passport photo, ICAO standard, 35x45mm. White background, no shadows. Don't change my appearance. Face height 32–36mm, head straight, eyes open, mouth closed. Remove glasses. Even diffused lighting.</pre>\n              </div>\n            </div>\n          </div>\n        </div>\n\n      </div><!-- /panel-zg -->\n    </div><!-- /pz-panels -->\n  </div><!-- /pz-tabs -->\n\n  <div class=\"pz-divider\"></div>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Теги</div>\n    <div class=\"pz-tags\">\n      <span class=\"pz-tag\">#фото на паспорт</span>\n      <span class=\"pz-tag\">#нейросеть фото документы</span>\n      <span class=\"pz-tag\">#AI фото на паспорт</span>\n      <span class=\"pz-tag\">#загранпаспорт фото нейросеть</span>\n      <span class=\"pz-tag\">#белый фон промт</span>\n      <span class=\"pz-tag\">#GPT Image 2 промт</span>\n      <span class=\"pz-tag\">#биометрическое фото ИИ</span>\n      <span class=\"pz-tag\">#ИКАО фото нейросеть</span>\n      <span class=\"pz-tag\">#промт для фото документов</span>\n      <span class=\"pz-tag\">#Nano Banana PRO</span>\n    </div>\n  </div>\n\n<p class=\"pz-desc\">Эту страницу можно использовать онлайн: промпт подходит для работы с ИИ и нейросетью.</p>\n</div>\n\n<script>\nfunction pzCopy(btn) {\n  var card = btn.closest('.pz-card, .pz-mini');\n  var body = card.querySelector('.pz-card-body, .pz-mini-body');\n  if (!body) return;\n  navigator.clipboard.writeText(body.innerText).then(function() {\n    btn.textContent = '✓ Скопировано';\n    btn.classList.add('ok');\n    setTimeout(function() {\n      btn.textContent = 'Копировать';\n      btn.classList.remove('ok');\n    }, 2000);\n  });\n}\n</script>"
}
