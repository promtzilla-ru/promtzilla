  "bodyHtml": "<style>\n.pz-wrap{max-width:780px;margin:0 auto;font-family:'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1a1830}\n.pz-eyebrow{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#0f7c80;margin-bottom:10px}\n.pz-title{font-size:28px;font-weight:800;color:#1a1830;line-height:1.2;margin:0 0 12px}\n.pz-title span{color:#0f7c80}\n.pz-desc{color:#5f6d73;font-size:14px;max-width:620px;margin:0 0 32px}\n.pz-note{padding:12px 14px;background:#fff7e6;border:1px solid #efd097;border-radius:8px;color:#5f4a1b}\n.pz-section{margin-bottom:32px}\n.pz-section-label{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#5f6d73;margin:0 0 16px;display:flex;align-items:center;gap:8px}\n.pz-section-label::after{content:'';flex:1;height:1px;background:#d9e2e3}\n.pz-card{background:#fff;border:1px solid #d9e2e3;border-radius:8px;overflow:hidden;margin-bottom:20px}\n.pz-card-head{display:flex;align-items:center;gap:10px;padding:11px 16px;background:#f3f7f7;border-bottom:1px solid #d9e2e3;flex-wrap:wrap}\n.pz-card-meta{font-size:12px;color:#5f6d73;margin-left:auto}\n.pz-card-body{padding:15px 16px;font-family:'Courier New',monospace;font-size:13px;line-height:1.7;color:#172126;white-space:pre-wrap;word-break:break-word;background:#fafafa;margin:0}\n.pz-ru,.pz-en{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;border:1px solid currentColor}\n.pz-ru{color:#e66d4f;background:rgba(230,109,79,.08)}\n.pz-en{color:#0f7c80;background:rgba(15,124,128,.08)}\n.pz-copy{background:#eef7f7;border:1px solid #b9dada;color:#0f7c80;font-size:12px;font-weight:700;padding:5px 12px;border-radius:6px;cursor:pointer;font-family:inherit;margin-left:auto;transition:all .15s}\n.pz-copy:hover{background:#0f7c80;color:#fff;border-color:#0f7c80}\n.pz-copy.ok{background:#e8f5e9;color:#2e7d32;border-color:#a5d6a7}\n.pz-photo-stack{display:grid;grid-template-columns:1fr;gap:10px;margin:0 0 24px}\n.pz-before-after{display:grid;grid-template-columns:1fr;gap:16px;margin:0 0 24px}\n.pz-result-panel{padding:18px;display:flex;flex-direction:column;gap:16px;box-sizing:border-box;background:linear-gradient(135deg,#f7fbfb,#fff)}\n.pz-result-thumb{width:180px;max-width:38%;border:1px solid #d9e2e3;border-radius:8px;overflow:hidden;background:#f3f7f7;flex-shrink:0}\n.pz-result-thumb img{width:100%;display:block}\n.pz-result-title{font-size:16px;font-weight:800;color:#172126;margin:0 0 8px}\n.pz-result-text{font-size:14px;line-height:1.6;color:#5f6d73;margin:0;overflow:visible}\n.pz-info-row{display:flex;align-items:flex-start;gap:16px}@media(max-width:680px){.pz-info-row{flex-direction:column}.pz-result-thumb{width:100%;max-width:none}}\n.pz-photo-item{background:#fff;border:1px solid #d9e2e3;border-radius:8px;overflow:hidden}\n.pz-photo-img{width:100%;overflow:hidden}\n.pz-photo-img img{width:100%;display:block}\n.pz-photo-cap{padding:8px 12px;border-top:1px solid #d9e2e3;font-size:12px;color:#5f6d73;display:flex;align-items:center;gap:6px}\n.pz-badge-result{font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;background:#e8f5e9;color:#2e7d32;border:1px solid #a5d6a7}\n.pz-howto{background:linear-gradient(135deg,rgba(15,124,128,.06),rgba(230,109,79,.04));border:1px solid rgba(15,124,128,.22);border-radius:8px;padding:22px;margin-bottom:32px}\n.pz-howto-title{font-size:14px;font-weight:800;color:#0f7c80;margin:0 0 16px}\n.pz-steps{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px}\n.pz-step{display:flex;gap:12px;align-items:flex-start}\n.pz-step-num{width:24px;height:24px;background:#0f7c80;color:#fff;font-size:11px;font-weight:800;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}\n.pz-step-text{font-size:14px;color:#172126;line-height:1.5}\n.pz-divider{height:1px;background:#d9e2e3;margin:28px 0}\n.pz-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}\n.pz-tag{background:#eef7f7;border:1px solid #b9dada;color:#0f7c80;font-size:12px;font-weight:700;padding:5px 13px;border-radius:20px}\n</style>\n\n<div class=\"pz-wrap\">\n  <div class=\"pz-eyebrow\">Промтзилла</div>\n  <h2 class=\"pz-title\">Как получить описание изображения с помощью ИИ</h2>\n  <p class=\"pz-desc\">Загрузи любое изображение, которое нужно описать — GPT Image 2 или Nano Banana PRO поможет проанализировать изображение и описать его понятным текстом.</p>\n\n  <div class=\"pz-howto\">\n    <div class=\"pz-howto-title\">Пошаговая инструкция</div>\n    <ul class=\"pz-steps\">\n      <li class=\"pz-step\"><div class=\"pz-step-num\">1</div><div class=\"pz-step-text\">Подготовь любое изображение, которое нужно описать: файл должен быть чётким, без сильных фильтров и лишнего сжатия.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">2</div><div class=\"pz-step-text\">Открой GPT Image 2 или Nano Banana PRO и загрузи исходное изображение.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">3</div><div class=\"pz-step-text\">Скопируй RU-промт ниже и вставь его в поле ввода вместе с фото.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">4</div><div class=\"pz-step-text\">Попроси сохранить важные детали: лицо, предметы, стиль, ракурс и естественное освещение.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">5</div><div class=\"pz-step-text\">Если результат выглядит слишком искусственно, добавь: «сделай мягче и реалистичнее, без чрезмерной ретуши».</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">6</div><div class=\"pz-step-text\">Сравни результат с исходником и выбери самый естественный вариант.</div></li>\n    </ul>\n  </div>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Пример: до и после</div>\n    <div class=\"pz-before-after\">\n      <div class=\"pz-photo-item\">\n        <div class=\"pz-photo-img\"><img src=\"/wp-content/uploads/2026/07/generated/kak-poluchit-opisanie-izobrazheniya-s-pomoshhju-ii.png\" alt=\"Исходное изображение для описания через ИИ\"></div>\n        <div class=\"pz-photo-cap\"><span class=\"pz-badge-result\">До</span>Загружаем обычную картинку: предметы на столе, растение, фото и экран с визуальными элементами.</div>\n      </div>\n      <div class=\"pz-photo-item\">\n        <div class=\"pz-result-panel\">\n          <div class=\"pz-info-row\">\n            <div class=\"pz-result-thumb\"><img src=\"/wp-content/uploads/2026/07/generated/kak-poluchit-opisanie-izobrazheniya-s-pomoshhju-ii.png\" alt=\"Миниатюра изображения после анализа ИИ\"></div>\n            <div>\n              <p class=\"pz-result-title\">Описание от нейросети</p>\n              <p class=\"pz-result-text\">На изображении показан рабочий стол у окна. В кадре ноутбук с визуальным редактором, смартфон с растением, фотоаппарат, распечатанная фотография и комнатное растение. Сцена светлая, аккуратная, в стиле рабочего процесса с ИИ.</p>\n            </div>\n          </div>\n        </div>\n        <div class=\"pz-photo-cap\"><span class=\"pz-badge-result\">После</span>ИИ оставляет миниатюру исходной картинки и рядом выдаёт понятное текстовое описание.</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Промт</div>\n    <div class=\"pz-card\">\n      <div class=\"pz-card-head\"><span class=\"pz-ru\">RU</span><span class=\"pz-card-meta\">GPT Image 2 или Nano Banana PRO · загрузи фото</span><button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button></div>\n      <pre class=\"pz-card-body\">Загружаю изображение. Нужно проанализировать изображение и описать его понятным текстом.\n\nЦель: получить подробное описание картинки.\n\nТребования:\n— Работай только с тем, что относится к задаче\n— Сохрани реалистичный вид изображения\n— Не искажай лица, руки, предметы, пропорции и фон без необходимости\n— Сохрани исходный ракурс, освещение и стиль снимка\n— Результат должен выглядеть аккуратно и естественно\n— Без лишнего текста, водяных знаков, рамок и логотипов</pre>\n    </div>\n    <div class=\"pz-card\">\n      <div class=\"pz-card-head\"><span class=\"pz-en\">EN</span><span class=\"pz-card-meta\">GPT Image 2 или Nano Banana PRO · upload photo</span><button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button></div>\n      <pre class=\"pz-card-body\">I'm uploading an image. Please analyze the uploaded image and describe it clearly.\n\nGoal: get a detailed image description.\n\nRequirements:\n- Edit or analyze only what is necessary for the task\n- Keep the image realistic and natural\n- Do not distort faces, hands, objects, proportions or the background unless required\n- Preserve the original angle, lighting and photo style\n- The result should look clean, polished and believable\n- No extra text, watermarks, frames or logos</pre>\n    </div>\n  </div>\n\n  <div class=\"pz-divider\"></div>\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Теги</div>\n    <div class=\"pz-tags\">\n      <span class=\"pz-tag\">#Получить описание изображения ИИ</span>\n      <span class=\"pz-tag\">#Получить описание изображения нейросеть</span>\n      <span class=\"pz-tag\">#получить подробное описание картинки</span>\n      <span class=\"pz-tag\">#GPT Image 2</span>\n      <span class=\"pz-tag\">#Nano Banana PRO</span>\n      <span class=\"pz-tag\">#промт для фото</span>\n      <span class=\"pz-tag\">#фоторетушь ИИ</span>\n      <span class=\"pz-tag\">#AI photo edit</span>\n      <span class=\"pz-tag\">#нейросеть для фото</span>\n      <span class=\"pz-tag\">#Промтзилла</span>\n    </div>\n  </div>\n<p class=\"pz-desc\">Эту страницу можно использовать онлайн: промпт подходит для работы с ИИ и нейросетью.</p>\n</div>\n\n<script>\nfunction pzCopy(btn) {\n  var card = btn.closest('.pz-card, .pz-mini');\n  var body = card.querySelector('.pz-card-body, .pz-mini-body');\n  if (!body) return;\n  navigator.clipboard.writeText(body.innerText).then(function() {\n    btn.textContent = 'Скопировано';\n    btn.classList.add('ok');\n    setTimeout(function() {\n      btn.textContent = 'Копировать';\n      btn.classList.remove('ok');\n    }, 2000);\n  });\n}\n</script>"
