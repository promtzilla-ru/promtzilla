  "bodyHtml": "<style>\n.pz-wrap{max-width:780px;margin:0 auto;font-family:'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1a1830}\n.pz-eyebrow{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#6b46fa;margin-bottom:10px}\n.pz-title{font-size:28px;font-weight:800;color:#1a1830;line-height:1.2;margin:0 0 12px}\n.pz-title span{background:linear-gradient(90deg,#6b46fa,#9b72ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}\n.pz-desc{color:#7b78a0;font-size:14px;max-width:560px;margin:0 0 32px}\n.pz-section{margin-bottom:32px}\n.pz-section-label{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#7b78a0;margin:0 0 16px;display:flex;align-items:center;gap:8px}\n.pz-section-label::after{content:'';flex:1;height:1px;background:#e0e0ec}\n.pz-card{background:#f7f7fb;border:1px solid #e0e0ec;border-radius:12px;overflow:hidden;margin-bottom:20px}\n.pz-card-head{display:flex;align-items:center;gap:10px;padding:11px 16px;background:#eeeef6;border-bottom:1px solid #e0e0ec;flex-wrap:wrap}\n.pz-card-meta{font-size:12px;color:#7b78a0;margin-left:auto}\n.pz-card-body{padding:15px 16px;font-family:'Courier New',monospace;font-size:13px;line-height:1.7;color:#2d2a4a;white-space:pre-wrap;word-break:break-word;background:#fafafa;margin:0}\n.pz-ru{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;background:rgba(217,48,37,.08);color:#d93025;border:1px solid rgba(217,48,37,.2)}\n.pz-en{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;background:rgba(26,115,232,.08);color:#1a73e8;border:1px solid rgba(26,115,232,.2)}\n.pz-copy{background:#f0edff;border:1px solid #cfc4ff;color:#6b46fa;font-size:12px;font-weight:600;padding:5px 12px;border-radius:6px;cursor:pointer;font-family:inherit;margin-left:auto;transition:all .15s}\n.pz-copy:hover{background:#6b46fa;color:#fff;border-color:#6b46fa}\n.pz-copy.ok{background:#e8f5e9;color:#2e7d32;border-color:#a5d6a7}\n.pz-photo-stack{display:grid;grid-template-columns:1fr;gap:10px;margin:0 0 24px}\n.pz-photo-item{background:#fff;border:1px solid #e0e0ec;border-radius:10px;overflow:hidden}\n.pz-photo-img{width:100%;aspect-ratio:3/4;overflow:hidden}\n.pz-photo-img img{width:100%;height:100%;object-fit:cover;display:block}\n.pz-photo-cap{padding:8px 12px;border-top:1px solid #e0e0ec;font-size:12px;color:#7b78a0;display:flex;align-items:center;gap:6px}\n.pz-badge-input{font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px;background:#fff3e0;color:#e65100;border:1px solid #ffcc80}\n.pz-badge-result{font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px;background:#e8f5e9;color:#2e7d32;border:1px solid #a5d6a7}\n.pz-howto{background:linear-gradient(135deg,rgba(107,70,250,.05),rgba(155,114,255,.03));border:1px solid rgba(107,70,250,.18);border-radius:12px;padding:22px;margin-bottom:32px}\n.pz-howto-title{font-size:14px;font-weight:700;color:#6b46fa;margin:0 0 16px}\n.pz-steps{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px}\n.pz-step{display:flex;gap:12px;align-items:flex-start}\n.pz-step-num{width:24px;height:24px;background:#6b46fa;color:#fff;font-size:11px;font-weight:800;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}\n.pz-step-text{font-size:14px;color:#1a1830;line-height:1.5}\n.pz-wrap strong{color:inherit}\n.pz-wrap a{color:inherit;text-decoration:none}\n.pz-wrap a:hover{text-decoration:underline}\n.pz-divider{height:1px;background:#e0e0ec;margin:28px 0}\n.pz-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}\n.pz-tag{background:#f0edff;border:1px solid #cfc4ff;color:#6b46fa;font-size:12px;font-weight:600;padding:5px 13px;border-radius:20px}\n</style>\n\n<div class=\"pz-wrap\">\n\n  <div class=\"pz-eyebrow\">Промтзилла</div>\n  <h2 class=\"pz-title\">Как удалить фон с фотографии с помощью нейросети</h2>\n  <p class=\"pz-desc\">Загрузи фото — Nano Banana PRO аккуратно удалит фон и оставит объект на прозрачном фоне, готовым для использования в дизайне.</p>\n\n  <div class=\"pz-howto\">\n    <div class=\"pz-howto-title\">📋 Пошаговая инструкция</div>\n    <ul class=\"pz-steps\">\n      <li class=\"pz-step\"><div class=\"pz-step-num\">1</div><div class=\"pz-step-text\">Перейди на <strong>study24.ai</strong> и открой инструмент <strong>Nano Banana PRO</strong></div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">2</div><div class=\"pz-step-text\">Нажми на иконку скрепки и <strong>загрузи своё фото</strong> — чем чётче контраст между объектом и фоном, тем лучше результат</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">3</div><div class=\"pz-step-text\">Скопируй промт ниже и <strong>вставь в поле ввода</strong></div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">4</div><div class=\"pz-step-text\">Нажми отправить и подожди 10–20 секунд — нейросеть <strong>удалит фон</strong></div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">5</div><div class=\"pz-step-text\">Если осталась белая кайма — добавь к промту: <strong>«убери белую кайму по краям объекта»</strong></div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">6</div><div class=\"pz-step-text\">Скачай результат в формате <strong>PNG с прозрачным фоном</strong></div></li>\n    </ul>\n  </div>\n\n  <!-- ФОТО -->\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Пример результата</div>\n    <div class=\"pz-photo-stack\">\n      <div class=\"pz-photo-item\">\n        <div class=\"pz-photo-img\"><img src=\"/wp-content/uploads/2026/07/Как-Удалить-Фон-с-Помощью-ИИ-ДО.png\" alt=\"Исходное фото\"></div>\n        <div class=\"pz-photo-cap\"><span class=\"pz-badge-input\">До</span>Исходное фото</div>\n      </div>\n      <div class=\"pz-photo-item\">\n        <div class=\"pz-photo-img\"><img src=\"/wp-content/uploads/2026/07/Как-Удалить-Фон-с-Помощью-ИИ-ПОСЛЕ.png\" alt=\"Фон удалён\"></div>\n        <div class=\"pz-photo-cap\"><span class=\"pz-badge-result\">После</span>Фон удалён</div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ПРОМТЫ -->\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Промт</div>\n\n    <div class=\"pz-card\">\n      <div class=\"pz-card-head\">\n        <span class=\"pz-ru\">RU</span>\n        <span class=\"pz-card-meta\">Nano Banana PRO · загрузи фото</span>\n        <button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button>\n      </div>\n      <pre class=\"pz-card-body\">Загружаю фотографию. Удали фон полностью и сделай его прозрачным.\n\nТребования:\n— Убрать фон полностью — оставить только основной объект (человек, предмет, продукт)\n— Края обрезать аккуратно и чётко — без размытия, без артефактов, без белой каймы\n— Сложные элементы (волосы, мех, тонкие детали) обработать тщательно\n— Объект не изменять — цвет, форму и детали сохранить точно\n— Результат: объект на прозрачном фоне, готов для использования в дизайне</pre>\n    </div>\n\n    <div class=\"pz-card\">\n      <div class=\"pz-card-head\">\n        <span class=\"pz-en\">EN</span>\n        <span class=\"pz-card-meta\">Nano Banana PRO · upload photo</span>\n        <button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button>\n      </div>\n      <pre class=\"pz-card-body\">I'm uploading a photo. Remove the background completely and make it transparent.\n\nRequirements:\n— Remove the background entirely — keep only the main subject (person, object, product)\n— Cut edges cleanly and precisely — no blur, no artifacts, no white fringe\n— Handle complex elements carefully (hair, fur, fine details)\n— Do not alter the subject — preserve color, shape and details exactly\n— Result: subject on transparent background, ready for use in design</pre>\n    </div>\n  </div>\n\n  <div class=\"pz-divider\"></div>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Теги</div>\n    <div class=\"pz-tags\">\n      <span class=\"pz-tag\">#удалить фон нейросеть</span>\n      <span class=\"pz-tag\">#убрать фон с фото ИИ</span>\n      <span class=\"pz-tag\">#Nano Banana PRO фон</span>\n      <span class=\"pz-tag\">#прозрачный фон нейросеть</span>\n      <span class=\"pz-tag\">#remove background AI</span>\n      <span class=\"pz-tag\">#вырезать объект ИИ</span>\n      <span class=\"pz-tag\">#фон PNG нейросеть</span>\n      <span class=\"pz-tag\">#промт удалить фон</span>\n      <span class=\"pz-tag\">#обтравка фото ИИ</span>\n      <span class=\"pz-tag\">#фото без фона онлайн</span>\n    </div>\n  </div>\n\n</div>\n\n<script>\nfunction pzCopy(btn) {\n  var card = btn.closest('.pz-card, .pz-mini');\n  var body = card.querySelector('.pz-card-body, .pz-mini-body');\n  if (!body) return;\n  navigator.clipboard.writeText(body.innerText).then(function() {\n    btn.textContent = '✓ Скопировано';\n    btn.classList.add('ok');\n    setTimeout(function() {\n      btn.textContent = 'Копировать';\n      btn.classList.remove('ok');\n    }, 2000);\n  });\n}\n</script>"
}
