  "bodyHtml": "<style>\n.pz-wrap{max-width:780px;margin:0 auto;font-family:'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1a1830}\n.pz-eyebrow{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#6b46fa;margin-bottom:10px}\n.pz-title{font-size:28px;font-weight:800;color:#1a1830;line-height:1.2;margin:0 0 12px}\n.pz-title span{background:linear-gradient(90deg,#6b46fa,#9b72ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}\n.pz-desc{color:#7b78a0;font-size:14px;max-width:560px;margin:0 0 32px}\n.pz-section{margin-bottom:32px}\n.pz-section-label{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#7b78a0;margin:0 0 16px;display:flex;align-items:center;gap:8px}\n.pz-section-label::after{content:'';flex:1;height:1px;background:#e0e0ec}\n.pz-card{background:#f7f7fb;border:1px solid #e0e0ec;border-radius:12px;overflow:hidden;margin-bottom:20px}\n.pz-card-head{display:flex;align-items:center;gap:10px;padding:11px 16px;background:#eeeef6;border-bottom:1px solid #e0e0ec;flex-wrap:wrap}\n.pz-card-meta{font-size:12px;color:#7b78a0;margin-left:auto}\n.pz-card-body{padding:15px 16px;font-family:'Courier New',monospace;font-size:13px;line-height:1.7;color:#2d2a4a;white-space:pre-wrap;word-break:break-word;background:#fafafa;margin:0}\n.pz-ru{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;background:rgba(217,48,37,.08);color:#d93025;border:1px solid rgba(217,48,37,.2)}\n.pz-en{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;background:rgba(26,115,232,.08);color:#1a73e8;border:1px solid rgba(26,115,232,.2)}\n.pz-copy{background:#f0edff;border:1px solid #cfc4ff;color:#6b46fa;font-size:12px;font-weight:600;padding:5px 12px;border-radius:6px;cursor:pointer;font-family:inherit;margin-left:auto;transition:all .15s}\n.pz-copy:hover{background:#6b46fa;color:#fff;border-color:#6b46fa}\n.pz-copy.ok{background:#e8f5e9;color:#2e7d32;border-color:#a5d6a7}\n.pz-ba{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:0 16px 16px}\n.pz-ba-item{background:#fff;border:1px solid #e0e0ec;border-radius:10px;overflow:hidden}\n.pz-ba-img{width:100%;aspect-ratio:16/9;background:#f0f0f0;overflow:hidden}\n.pz-ba-img img{width:100%;height:100%;object-fit:cover;display:block}\n.pz-ba-cap{padding:8px 12px;border-top:1px solid #e0e0ec;display:flex;align-items:center;gap:6px}\n.pz-badge-before{font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px;background:#fff3e0;color:#e65100;border:1px solid #ffcc80}\n.pz-badge-after{font-size:11px;font-weight:600;padding:2px 8px;border-radius:20px;background:#e8f5e9;color:#2e7d32;border:1px solid #a5d6a7}\n.pz-ba-cap-text{font-size:12px;color:#7b78a0}\n.pz-tool{background:#f7f7fb;border:1px solid #e0e0ec;border-radius:12px;overflow:hidden;margin-bottom:20px}\n.pz-tool-head{display:flex;align-items:center;gap:10px;padding:13px 18px;background:#eeeef6;border-bottom:1px solid #e0e0ec}\n.pz-tool-icon{width:32px;height:32px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}\n.pz-tool-icon-nano{background:linear-gradient(135deg,#7c5cfc,#4e35b0)}\n.pz-tool-icon-kling{background:linear-gradient(135deg,#e8523a,#b83220)}\n.pz-tool-name{font-weight:700;font-size:15px;color:#1a1830}\n.pz-tool-tag{font-size:11px;color:#7b78a0;background:#fff;border:1px solid #e0e0ec;padding:2px 8px;border-radius:4px;margin-left:auto}\n.pz-tool-body{padding:14px;display:flex;flex-direction:column;gap:12px}\n.pz-mini{background:#fff;border:1px solid #e0e0ec;border-radius:8px;overflow:hidden}\n.pz-mini-head{display:flex;align-items:center;gap:8px;padding:8px 14px;background:#eeeef6;border-bottom:1px solid #e0e0ec}\n.pz-mini-body{padding:12px 14px;font-family:'Courier New',monospace;font-size:12.5px;line-height:1.65;color:#2d2a4a;white-space:pre-wrap;word-break:break-word;margin:0}\n.pz-mini-ba{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 14px 14px}\n.pz-video-wrap{margin:0 16px 16px;border-radius:10px;overflow:hidden;border:1px solid #e0e0ec;background:#000}\n.pz-video-wrap video{width:100%;display:block}\n.pz-video-cap{padding:8px 12px;background:#fff;border-top:1px solid #e0e0ec;display:flex;align-items:center;gap:6px}\n.pz-howto{background:linear-gradient(135deg,rgba(107,70,250,.05),rgba(155,114,255,.03));border:1px solid rgba(107,70,250,.18);border-radius:12px;padding:22px;margin-bottom:32px}\n.pz-howto-title{font-size:14px;font-weight:700;color:#6b46fa;margin:0 0 16px}\n.pz-steps{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px}\n.pz-step{display:flex;gap:12px;align-items:flex-start}\n.pz-step-num{width:24px;height:24px;background:#6b46fa;color:#fff;font-size:11px;font-weight:800;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}\n.pz-step-text{font-size:14px;color:#1a1830;line-height:1.5}\n.pz-wrap strong{color:inherit}\n.pz-wrap a{color:inherit;text-decoration:none}\n.pz-wrap a:hover{text-decoration:underline}\n.pz-divider{height:1px;background:#e0e0ec;margin:28px 0}\n.pz-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}\n.pz-tag{background:#f0edff;border:1px solid #cfc4ff;color:#6b46fa;font-size:12px;font-weight:600;padding:5px 13px;border-radius:20px}\n</style>\n\n<div class=\"pz-wrap\">\n\n  <div class=\"pz-eyebrow\">Промтзилла</div>\n  <h2 class=\"pz-title\">Оживление детского рисунка<br><span>с помощью нейросети</span></h2>\n  <p class=\"pz-desc\">Два шага: сначала подготовь рисунок в Nano Banana PRO, затем оживи его в Kling. Готовые промты для каждого этапа — RU и EN.</p>\n\n  <div class=\"pz-howto\">\n    <div class=\"pz-howto-title\">📋 Пошаговая инструкция</div>\n    <ul class=\"pz-steps\">\n      <li class=\"pz-step\"><div class=\"pz-step-num\">1</div><div class=\"pz-step-text\">Сфотографируй или отсканируй детский рисунок — <strong>хорошее освещение, без теней</strong></div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">2</div><div class=\"pz-step-text\">Перейди на <strong>study24.ai</strong>, открой <strong>Nano Banana PRO</strong>, загрузи фото рисунка</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">3</div><div class=\"pz-step-text\">Скопируй промт из <strong>Шага 1</strong> ниже, вставь и отправь — получишь подготовленный рисунок</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">4</div><div class=\"pz-step-text\">Скачай результат и загрузи его в <strong>Kling</strong> (klingai.com)</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">5</div><div class=\"pz-step-text\">Скопируй промт из <strong>Шага 2</strong> ниже, вставь в Kling и запусти генерацию</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">6</div><div class=\"pz-step-text\">Скачай готовое видео и <strong>поделись в соцсетях</strong></div></li>\n    </ul>\n  </div>\n\n  <!-- ===== ШАГ 1: NANO BANANA PRO ===== -->\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Шаг 1 — Подготовка рисунка</div>\n\n    <div class=\"pz-tool\">\n      <div class=\"pz-tool-head\">\n        <div class=\"pz-tool-icon pz-tool-icon-nano\">🍌</div>\n        <div class=\"pz-tool-name\">Nano Banana PRO</div>\n        <div class=\"pz-tool-tag\">Study AI · загрузи рисунок</div>\n      </div>\n      <div class=\"pz-tool-body\">\n        <div style=\"display:grid;grid-template-columns:1fr;gap:8px;margin:14px 14px 14px\">\n          <div class=\"pz-ba-item\">\n            <div class=\"pz-ba-img\"><img src=\"/wp-content/uploads/2026/06/Как-оживить-детское-фото-с-помощью-ИИ-ДО.png\" alt=\"До\"></div>\n            <div class=\"pz-ba-cap\"><span class=\"pz-badge-before\">До</span><span class=\"pz-ba-cap-text\">Исходный рисунок</span></div>\n          </div>\n          <div class=\"pz-ba-item\">\n            <div class=\"pz-ba-img\"><img src=\"/wp-content/uploads/2026/06/Как-оживить-детское-фото-с-помощью-ИИ-ПОСЛЕ.png\" alt=\"После\"></div>\n            <div class=\"pz-ba-cap\"><span class=\"pz-badge-after\">После</span><span class=\"pz-ba-cap-text\">Подготовленный рисунок</span></div>\n          </div>\n        </div>\n        <div class=\"pz-mini\">\n          <div class=\"pz-mini-head\">\n            <span class=\"pz-ru\">RU</span>\n            <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n          </div>\n          <pre class=\"pz-mini-body\">На входе — детский рисунок (фото или скан). Подготовь его для анимации в видеогенераторе.\n\nЧто сделать:\n— Фон сделать чисто белым, убрать тени и мятые края листа\n— Линии рисунка сделать чёткими и контрастными, но сохранить детский стиль — не выравнивать, не сглаживать\n— Цвета усилить и сделать насыщеннее, чтобы при анимации они выглядели ярко\n— Убрать пятна, грязь, следы карандаша за пределами рисунка\n— Сам рисунок (персонаж, объекты) не изменять — только фон и качество\n— Не добавлять новые элементы, тени, блики или текстуры</pre>\n        </div>\n        <div class=\"pz-mini\">\n          <div class=\"pz-mini-head\">\n            <span class=\"pz-en\">EN</span>\n            <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n          </div>\n          <pre class=\"pz-mini-body\">Input is a children's drawing (photo or scan). Prepare it for animation in a video generator.\n\nWhat to do:\n— Make the background pure white, remove shadows and crumpled paper edges\n— Make the drawing lines sharp and contrasty, but preserve the childlike style — do not straighten or smooth\n— Boost colors and make them more saturated so they look vivid during animation\n— Remove stains, dirt, pencil marks outside the drawing area\n— Do not alter the drawing itself (character, objects) — only clean the background and improve quality\n— Do not add new elements, shadows, highlights or textures</pre>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <!-- ===== ШАГ 2: KLING ===== -->\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Шаг 2 — Оживление видео</div>\n\n    <div class=\"pz-tool\">\n      <div class=\"pz-tool-head\">\n        <div class=\"pz-tool-icon pz-tool-icon-kling\">▶</div>\n        <div class=\"pz-tool-name\">Kling</div>\n        <div class=\"pz-tool-tag\">klingai.com · загрузи подготовленный рисунок</div>\n      </div>\n      <div class=\"pz-tool-body\">\n        <div class=\"pz-video-wrap\">\n          <video controls playsinline>\n            <source src=\"/wp-content/uploads/2026/06/Как-оживить-детское-фото-с-помощью-нейросети.mp4\" type=\"video/mp4\">\n          </video>\n          <div class=\"pz-video-cap\"><span class=\"pz-badge-after\">Результат</span><span class=\"pz-ba-cap-text\">Оживлённый рисунок — Kling</span></div>\n        </div>\n        <div class=\"pz-mini\">\n          <div class=\"pz-mini-head\">\n            <span class=\"pz-ru\">RU</span>\n            <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n          </div>\n          <pre class=\"pz-mini-body\">На входе — детский рисунок. Оживи его, сохранив оригинальный стиль рисунка полностью.\n\nДвижение: персонаж начинает двигаться естественно — моргает, дышит, слегка покачивается.\nСтиль анимации: мягкий, плавный, как в детском мультфильме.\nФон: если есть фон на рисунке — он тоже оживает (облака плывут, трава колышется, вода рябит).\nЦвета: сохранить точно как в оригинале, не улучшать и не насыщать.\nЛинии: сохранить детскую неровность линий — не сглаживать, не делать «профессиональными».\nАтмосфера: тёплая, добрая, сказочная.\nДлительность: 3–5 секунд, зацикленная анимация.\nНе добавлять реалистичные текстуры, 3D-эффекты или фотореализм.</pre>\n        </div>\n        <div class=\"pz-mini\">\n          <div class=\"pz-mini-head\">\n            <span class=\"pz-en\">EN</span>\n            <button class=\"pz-copy\" onclick=\"pzCopy(this)\" style=\"margin-left:auto\">Копировать</button>\n          </div>\n          <pre class=\"pz-mini-body\">Input is a children's drawing. Bring it to life while fully preserving the original drawing style.\n\nMotion: the character starts moving naturally — blinking, breathing, gently swaying.\nAnimation style: soft, smooth, like a children's cartoon.\nBackground: if there is a background in the drawing — it comes alive too (clouds drift, grass sways, water ripples).\nColors: preserve exactly as in the original, do not enhance or oversaturate.\nLines: keep the childlike uneven lines — do not smooth or make them look professional.\nAtmosphere: warm, kind, fairytale-like.\nDuration: 3–5 seconds, looped animation.\nDo not add realistic textures, 3D effects or photorealism.</pre>\n        </div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"pz-divider\"></div>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Теги</div>\n    <div class=\"pz-tags\">\n      <span class=\"pz-tag\">#оживить детский рисунок ИИ</span>\n      <span class=\"pz-tag\">#Kling промт анимация</span>\n      <span class=\"pz-tag\">#детский рисунок нейросеть</span>\n      <span class=\"pz-tag\">#анимация рисунка ИИ</span>\n      <span class=\"pz-tag\">#Nano Banana PRO рисунок</span>\n      <span class=\"pz-tag\">#оживить рисунок видео</span>\n      <span class=\"pz-tag\">#генерация видео из рисунка</span>\n      <span class=\"pz-tag\">#детский мультфильм ИИ</span>\n      <span class=\"pz-tag\">#Kling детский рисунок</span>\n      <span class=\"pz-tag\">#промт для анимации</span>\n    </div>\n  </div>\n\n</div>\n\n<script>\nfunction pzCopy(btn) {\n  var card = btn.closest('.pz-card, .pz-mini');\n  var body = card.querySelector('.pz-card-body, .pz-mini-body');\n  if (!body) return;\n  navigator.clipboard.writeText(body.innerText).then(function() {\n    btn.textContent = '✓ Скопировано';\n    btn.classList.add('ok');\n    setTimeout(function() {\n      btn.textContent = 'Копировать';\n      btn.classList.remove('ok');\n    }, 2000);\n  });\n}\n</script>"
}