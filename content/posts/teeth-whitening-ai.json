  "bodyHtml": "<style>\n.pz-wrap{max-width:780px;margin:0 auto;font-family:'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1a1830}\n.pz-eyebrow{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#0f7c80;margin-bottom:10px}\n.pz-title{font-size:28px;font-weight:800;color:#1a1830;line-height:1.2;margin:0 0 12px}\n.pz-title span{color:#0f7c80}\n.pz-desc{color:#5f6d73;font-size:14px;max-width:620px;margin:0 0 32px}\n.pz-section{margin-bottom:32px}\n.pz-section-label{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#5f6d73;margin:0 0 16px;display:flex;align-items:center;gap:8px}\n.pz-section-label::after{content:'';flex:1;height:1px;background:#d9e2e3}\n.pz-card{background:#fff;border:1px solid #d9e2e3;border-radius:8px;overflow:hidden;margin-bottom:20px}\n.pz-card-head{display:flex;align-items:center;gap:10px;padding:11px 16px;background:#f3f7f7;border-bottom:1px solid #d9e2e3;flex-wrap:wrap}\n.pz-card-meta{font-size:12px;color:#5f6d73;margin-left:auto}\n.pz-card-body{padding:15px 16px;font-family:'Courier New',monospace;font-size:13px;line-height:1.7;color:#172126;white-space:pre-wrap;word-break:break-word;background:#fafafa;margin:0}\n.pz-ru,.pz-en{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;border:1px solid currentColor}\n.pz-ru{color:#e66d4f;background:rgba(230,109,79,.08)}\n.pz-en{color:#0f7c80;background:rgba(15,124,128,.08)}\n.pz-copy{background:#eef7f7;border:1px solid #b9dada;color:#0f7c80;font-size:12px;font-weight:700;padding:5px 12px;border-radius:6px;cursor:pointer;font-family:inherit;margin-left:auto;transition:all .15s}\n.pz-copy:hover{background:#0f7c80;color:#fff;border-color:#0f7c80}\n.pz-copy.ok{background:#e8f5e9;color:#2e7d32;border-color:#a5d6a7}\n.pz-photo-stack{display:grid;grid-template-columns:1fr;gap:10px;margin:0 0 24px}\n.pz-ba-stack{display:grid;grid-template-columns:1fr;gap:12px;margin:0 0 24px}\n.pz-ba-crop{width:100%;aspect-ratio:1.58/1;overflow:hidden;background:#f3f7f7}\n.pz-ba-crop img{width:200%;height:100%;object-fit:cover;display:block;max-width:none}\n.pz-ba-crop-after img{transform:translateX(-50%)}\n.pz-photo-item{background:#fff;border:1px solid #d9e2e3;border-radius:8px;overflow:hidden}\n.pz-photo-img{width:100%;overflow:hidden}\n.pz-photo-img img{width:100%;display:block}\n.pz-photo-cap{padding:8px 12px;border-top:1px solid #d9e2e3;font-size:12px;color:#5f6d73;display:flex;align-items:center;gap:6px}\n.pz-badge-result{font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;background:#e8f5e9;color:#2e7d32;border:1px solid #a5d6a7}\n.pz-howto{background:linear-gradient(135deg,rgba(15,124,128,.06),rgba(230,109,79,.04));border:1px solid rgba(15,124,128,.22);border-radius:8px;padding:22px;margin-bottom:32px}\n.pz-howto-title{font-size:14px;font-weight:800;color:#0f7c80;margin:0 0 16px}\n.pz-steps{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px}\n.pz-step{display:flex;gap:12px;align-items:flex-start}\n.pz-step-num{width:24px;height:24px;background:#0f7c80;color:#fff;font-size:11px;font-weight:800;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}\n.pz-step-text{font-size:14px;color:#172126;line-height:1.5}\n.pz-divider{height:1px;background:#d9e2e3;margin:28px 0}\n.pz-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}\n.pz-tag{background:#eef7f7;border:1px solid #b9dada;color:#0f7c80;font-size:12px;font-weight:700;padding:5px 13px;border-radius:20px}\n</style>\n\n<div class=\"pz-wrap\">\n\n  <div class=\"pz-eyebrow\">Промтзилла</div>\n  <h2 class=\"pz-title\">Как отбелить зубы на фото через ИИ</h2>\n  <p class=\"pz-desc\">Загрузи портрет с улыбкой — GPT Image 2 или Nano Banana PRO мягко осветлит зубы, уберёт желтизну и сохранит естественный вид без пластиковой белизны.</p>\n\n  <div class=\"pz-howto\">\n    <div class=\"pz-howto-title\">Пошаговая инструкция</div>\n    <ul class=\"pz-steps\">\n      <li class=\"pz-step\"><div class=\"pz-step-num\">1</div><div class=\"pz-step-text\">Выбери фото, где улыбка хорошо видна: зубы не перекрыты губами, тенью или сильным бликом.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">2</div><div class=\"pz-step-text\">Открой GPT Image 2 или Nano Banana PRO и загрузи исходный снимок.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">3</div><div class=\"pz-step-text\">Скопируй промт ниже и вставь его в поле ввода вместе с фото.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">4</div><div class=\"pz-step-text\">Попроси сделать именно лёгкое естественное осветление, а не менять форму зубов или улыбку.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">5</div><div class=\"pz-step-text\">Если результат стал слишком белым, добавь: «уменьши эффект, сохрани натуральный оттенок эмали».</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">6</div><div class=\"pz-step-text\">Сравни результат с оригиналом и выбери вариант, где улыбка выглядит чисто, но естественно.</div></li>\n    </ul>\n  </div>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Пример результата</div>\n    <div class=\"pz-ba-stack\">\n      <div class=\"pz-photo-item\">\n        <div class=\"pz-ba-crop pz-ba-crop-before\"><img src=\"/wp-content/uploads/2026/07/kak-otbelit-zuby-na-foto-cherez-ii.png\" alt=\"До и после отбеливания зубов на фото через ИИ — до\"></div>\n        <div class=\"pz-photo-cap\"><span class=\"pz-badge-result\">До</span>Исходное фото до обработки.</div>\n      </div>\n      <div class=\"pz-photo-item\">\n        <div class=\"pz-ba-crop pz-ba-crop-after\"><img src=\"/wp-content/uploads/2026/07/kak-otbelit-zuby-na-foto-cherez-ii.png\" alt=\"До и после отбеливания зубов на фото через ИИ — после\"></div>\n        <div class=\"pz-photo-cap\"><span class=\"pz-badge-result\">После</span>Естественное осветление зубов без изменения улыбки</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Промт</div>\n\n    <div class=\"pz-card\">\n      <div class=\"pz-card-head\">\n        <span class=\"pz-ru\">RU</span>\n        <span class=\"pz-card-meta\">GPT Image 2 / Nano Banana PRO · загрузи фото</span>\n        <button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button>\n      </div>\n      <pre class=\"pz-card-body\">Загружаю портретное фото человека с улыбкой. Аккуратно осветли зубы на фото, чтобы улыбка выглядела чище и свежее, но осталась естественной.\n\nТребования:\n— Осветлить только зубы, не менять губы, кожу, лицо, форму улыбки и выражение\n— Убрать лёгкую желтизну и сделать оттенок эмали более ровным\n— Не делать зубы ослепительно белыми, пластиковыми или неестественными\n— Сохранить форму, размер и положение каждого зуба\n— Не добавлять новые зубы, не выравнивать прикус и не менять анатомию\n— Сохранить исходное освещение, тени и текстуру фото\n— Результат должен выглядеть как аккуратная фоторетушь, а не как стоматологическая реклама\n— Без текста, подписей, водяных знаков и рамок</pre>\n    </div>\n\n    <div class=\"pz-card\">\n      <div class=\"pz-card-head\">\n        <span class=\"pz-en\">EN</span>\n        <span class=\"pz-card-meta\">GPT Image 2 / Nano Banana PRO · upload photo</span>\n        <button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button>\n      </div>\n      <pre class=\"pz-card-body\">I'm uploading a portrait photo of a person smiling. Carefully whiten the teeth so the smile looks cleaner and fresher while staying natural.\n\nRequirements:\n— Whiten only the teeth; do not change the lips, skin, face, smile shape or expression\n— Reduce slight yellow tones and make the enamel color more even\n— Do not make the teeth blinding white, plastic-looking or unnatural\n— Preserve the shape, size and position of every tooth\n— Do not add new teeth, do not straighten the bite and do not change anatomy\n— Preserve the original lighting, shadows and photo texture\n— The result should look like subtle professional photo retouching, not a dental advertisement\n— No text, captions, watermarks or frames</pre>\n    </div>\n  </div>\n\n  <div class=\"pz-divider\"></div>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Теги</div>\n    <div class=\"pz-tags\">\n      <span class=\"pz-tag\">#отбелить зубы на фото ИИ</span>\n      <span class=\"pz-tag\">#отбеливание зубов нейросеть</span>\n      <span class=\"pz-tag\">#сделать зубы белее на фото</span>\n      <span class=\"pz-tag\">#ретушь улыбки ИИ</span>\n      <span class=\"pz-tag\">#GPT Image 2 зубы</span>\n      <span class=\"pz-tag\">#Nano Banana PRO ретушь</span>\n      <span class=\"pz-tag\">#естественная ретушь зубов</span>\n      <span class=\"pz-tag\">#AI teeth whitening</span>\n      <span class=\"pz-tag\">#промт отбелить зубы</span>\n      <span class=\"pz-tag\">#фоторетушь улыбки нейросеть</span>\n    </div>\n  </div>\n\n</div>\n\n<script>\nfunction pzCopy(btn) {\n  var card = btn.closest('.pz-card, .pz-mini');\n  var body = card.querySelector('.pz-card-body, .pz-mini-body');\n  if (!body) return;\n  navigator.clipboard.writeText(body.innerText).then(function() {\n    btn.textContent = 'Скопировано';\n    btn.classList.add('ok');\n    setTimeout(function() {\n      btn.textContent = 'Копировать';\n      btn.classList.remove('ok');\n    }, 2000);\n  });\n}\n</script>"
