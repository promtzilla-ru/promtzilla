  "bodyHtml": "<style>\n.pz-wrap{max-width:780px;margin:0 auto;font-family:'Segoe UI',system-ui,sans-serif;font-size:15px;line-height:1.65;color:#1a1830}\n.pz-eyebrow{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#0f7c80;margin-bottom:10px}\n.pz-title{font-size:28px;font-weight:800;color:#1a1830;line-height:1.2;margin:0 0 12px}\n.pz-title span{color:#0f7c80}\n.pz-desc{color:#5f6d73;font-size:14px;max-width:620px;margin:0 0 32px}\n.pz-note{padding:12px 14px;background:#fff7e6;border:1px solid #efd097;border-radius:8px;color:#5f4a1b}\n.pz-section{margin-bottom:32px}\n.pz-section-label{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#5f6d73;margin:0 0 16px;display:flex;align-items:center;gap:8px}\n.pz-section-label::after{content:'';flex:1;height:1px;background:#d9e2e3}\n.pz-card{background:#fff;border:1px solid #d9e2e3;border-radius:8px;overflow:hidden;margin-bottom:20px}\n.pz-card-head{display:flex;align-items:center;gap:10px;padding:11px 16px;background:#f3f7f7;border-bottom:1px solid #d9e2e3;flex-wrap:wrap}\n.pz-card-meta{font-size:12px;color:#5f6d73;margin-left:auto}\n.pz-card-body{padding:15px 16px;font-family:'Courier New',monospace;font-size:13px;line-height:1.7;color:#172126;white-space:pre-wrap;word-break:break-word;background:#fafafa;margin:0}\n.pz-ru,.pz-en{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;border:1px solid currentColor}\n.pz-ru{color:#e66d4f;background:rgba(230,109,79,.08)}\n.pz-en{color:#0f7c80;background:rgba(15,124,128,.08)}\n.pz-copy{background:#eef7f7;border:1px solid #b9dada;color:#0f7c80;font-size:12px;font-weight:700;padding:5px 12px;border-radius:6px;cursor:pointer;font-family:inherit;margin-left:auto;transition:all .15s}\n.pz-copy:hover{background:#0f7c80;color:#fff;border-color:#0f7c80}\n.pz-copy.ok{background:#e8f5e9;color:#2e7d32;border-color:#a5d6a7}\n.pz-photo-stack{display:grid;grid-template-columns:1fr;gap:10px;margin:0 0 24px}\n.pz-photo-item{background:#fff;border:1px solid #d9e2e3;border-radius:8px;overflow:hidden}\n.pz-photo-img{width:100%;overflow:hidden}\n.pz-photo-img img{width:100%;display:block}\n.pz-photo-cap{padding:8px 12px;border-top:1px solid #d9e2e3;font-size:12px;color:#5f6d73;display:flex;align-items:center;gap:6px}\n.pz-badge-result{font-size:11px;font-weight:700;padding:2px 8px;border-radius:20px;background:#e8f5e9;color:#2e7d32;border:1px solid #a5d6a7}\n.pz-howto{background:linear-gradient(135deg,rgba(15,124,128,.06),rgba(230,109,79,.04));border:1px solid rgba(15,124,128,.22);border-radius:8px;padding:22px;margin-bottom:32px}\n.pz-howto-title{font-size:14px;font-weight:800;color:#0f7c80;margin:0 0 16px}\n.pz-steps{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px}\n.pz-step{display:flex;gap:12px;align-items:flex-start}\n.pz-step-num{width:24px;height:24px;background:#0f7c80;color:#fff;font-size:11px;font-weight:800;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:1px}\n.pz-step-text{font-size:14px;color:#172126;line-height:1.5}\n.pz-divider{height:1px;background:#d9e2e3;margin:28px 0}\n.pz-tags{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}\n.pz-tag{background:#eef7f7;border:1px solid #b9dada;color:#0f7c80;font-size:12px;font-weight:700;padding:5px 13px;border-radius:20px}\n</style>\n\n<div class=\"pz-wrap\">\n  <div class=\"pz-eyebrow\">Промтзилла</div>\n  <h2 class=\"pz-title\">Как сделать своё фото чёрно-белым с помощью нейросети</h2>\n  <p class=\"pz-desc\">Загрузи любое цветное фото — GPT Image 2 или Nano Banana PRO поможет сделать чёрно-белую версию с красивым контрастом.</p>\n\n  <div class=\"pz-howto\">\n    <div class=\"pz-howto-title\">Пошаговая инструкция</div>\n    <ul class=\"pz-steps\">\n      <li class=\"pz-step\"><div class=\"pz-step-num\">1</div><div class=\"pz-step-text\">Выбери цветное фото с хорошим светом, деталями и понятным главным объектом.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">2</div><div class=\"pz-step-text\">Открой GPT Image 2 или Nano Banana PRO и загрузи исходное изображение.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">3</div><div class=\"pz-step-text\">Скопируй RU-промт ниже и укажи стиль чёрно-белой обработки: мягкий, контрастный, плёночный или журнальный.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">4</div><div class=\"pz-step-text\">Попроси сохранить лицо, фактуру кожи, свет, тени, резкость и естественный объём.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">5</div><div class=\"pz-step-text\">Если результат плоский, попроси усилить микроконтраст и разделить светлые, средние и тёмные тона.</div></li>\n      <li class=\"pz-step\"><div class=\"pz-step-num\">6</div><div class=\"pz-step-text\">Сравни с исходником: должен измениться только цветовой режим и тональность, без искажения кадра.</div></li>\n    </ul>\n  </div>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Пример: до и после</div>\n    <div class=\"pz-photo-stack\">\n      <div class=\"pz-photo-item\">\n        <div class=\"pz-photo-img\"><img src=\"/wp-content/uploads/2026/07/generated/kak-sdelat-svoe-foto-cherno-belym-s-pomoshhju-nejroseti-before.jpg\" alt=\"Цветное фото до чёрно-белой обработки\"></div>\n        <div class=\"pz-photo-cap\"><span class=\"pz-badge-result\">До</span>Исходное цветное фото с яркими оттенками и вечерним светом.</div>\n      </div>\n      <div class=\"pz-photo-item\">\n        <div class=\"pz-photo-img\"><img src=\"/wp-content/uploads/2026/07/generated/kak-sdelat-svoe-foto-cherno-belym-s-pomoshhju-nejroseti-after.jpg\" alt=\"Фото после чёрно-белой обработки\"></div>\n        <div class=\"pz-photo-cap\"><span class=\"pz-badge-result\">После</span>Чёрно-белая версия сохраняет свет, объём, детали и контраст.</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Промт</div>\n    <div class=\"pz-card\">\n      <div class=\"pz-card-head\"><span class=\"pz-ru\">RU</span><span class=\"pz-card-meta\">GPT Image 2 или Nano Banana PRO · загрузи фото</span><button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button></div>\n      <pre class=\"pz-card-body\">Загружаю цветное фото. Нужно сделать качественную чёрно-белую версию.\n\nСтиль обработки: {{СТИЛЬ_ЧБ_НАПРИМЕР_МЯГКИЙ_КОНТРАСТНЫЙ_ПЛЁНОЧНЫЙ_ЖУРНАЛЬНЫЙ}}.\n\nЦель: получить выразительную чёрно-белую фотографию без потери деталей.\n\nТребования:\n— Не меняй композицию, лица, позы, фон, предметы и пропорции\n— Убери цвет полностью, без цветных пятен и тонировки\n— Сохрани естественный свет, тени, фактуру кожи, ткани и фоновые детали\n— Настрой контраст так, чтобы были читаемы светлые, средние и тёмные тона\n— Не делай фото плоским, серым, пересвеченным или слишком жёстким\n— Сохрани резкость и естественный объём кадра\n— Без лишнего текста, рамок, логотипов и водяных знаков</pre>\n    </div>\n    <div class=\"pz-card\">\n      <div class=\"pz-card-head\"><span class=\"pz-en\">EN</span><span class=\"pz-card-meta\">GPT Image 2 или Nano Banana PRO · upload photo</span><button class=\"pz-copy\" onclick=\"pzCopy(this)\">Копировать</button></div>\n      <pre class=\"pz-card-body\">I'm uploading a color photo. Create a high-quality black-and-white version.\n\nProcessing style: {{BW_STYLE_FOR_EXAMPLE_SOFT_CONTRASTY_FILM_EDITORIAL}}.\n\nGoal: get an expressive black-and-white photo without losing details.\n\nRequirements:\n- Do not change the composition, faces, poses, background, objects or proportions\n- Remove color completely, with no color patches or tinting\n- Preserve natural light, shadows, skin texture, fabric texture and background details\n- Adjust contrast so highlights, midtones and shadows all remain readable\n- Do not make the photo flat, muddy, overexposed or too harsh\n- Preserve sharpness and natural depth\n- No extra text, frames, logos or watermarks</pre>\n    </div>\n  </div>\n\n  <div class=\"pz-divider\"></div>\n  <div class=\"pz-section\">\n    <div class=\"pz-section-label\">Теги</div>\n    <div class=\"pz-tags\">\n      <span class=\"pz-tag\">#Сделать свое фото черно-белым ИИ</span>\n      <span class=\"pz-tag\">#Сделать свое фото черно-белым нейросеть</span>\n      <span class=\"pz-tag\">#создать чёрно-белую фотографию</span>\n      <span class=\"pz-tag\">#GPT Image 2</span>\n      <span class=\"pz-tag\">#Nano Banana PRO</span>\n      <span class=\"pz-tag\">#промт для фото</span>\n      <span class=\"pz-tag\">#фоторетушь ИИ</span>\n      <span class=\"pz-tag\">#AI photo edit</span>\n      <span class=\"pz-tag\">#нейросеть для фото</span>\n      <span class=\"pz-tag\">#Промтзилла</span>\n    </div>\n  </div>\n</div>\n\n<script>\nfunction pzCopy(btn) {\n  var card = btn.closest('.pz-card, .pz-mini');\n  var body = card.querySelector('.pz-card-body, .pz-mini-body');\n  if (!body) return;\n  navigator.clipboard.writeText(body.innerText).then(function() {\n    btn.textContent = 'Скопировано';\n    btn.classList.add('ok');\n    setTimeout(function() {\n      btn.textContent = 'Копировать';\n      btn.classList.remove('ok');\n    }, 2000);\n  });\n}\n</script>"
